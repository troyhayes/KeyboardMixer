<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KeyboardMixer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeyboardMixer.Views"
    Title="KeyboardMixer">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable region) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Image
                    Width="16"
                    Height="16"
                    Source="ms-appx:///Assets/icon.ico" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="KeyboardMixer" />
            </StackPanel>
        </Grid>

        <local:SettingsPage Grid.Row="1" />
    </Grid>
</Window>
