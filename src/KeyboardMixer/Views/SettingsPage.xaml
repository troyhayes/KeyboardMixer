<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeyboardMixer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:KeyboardMixer.ViewModels">

    <Page.Resources>
        <!-- Right-hand side of a shortcut card: warning, key chips, enable toggle, edit/delete -->
        <DataTemplate x:Key="AppBindingTemplate" x:DataType="vm:BindingItemViewModel">
            <controls:SettingsCard Description="{x:Bind Subtitle}" Header="{x:Bind Title}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="{x:Bind Icon, Mode=OneWay}" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE7BA;"
                        ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay}"
                        Visibility="{x:Bind HasError, Mode=OneWay}" />
                    <ItemsControl
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind KeysDescription}"
                        ToolTipService.ToolTip="{x:Bind KeysDescription}"
                        ItemTemplate="{StaticResource KeyChipTemplate}"
                        ItemsPanel="{StaticResource KeyChipPanel}"
                        ItemsSource="{x:Bind Keys}" />
                    <ToggleSwitch
                        MinWidth="0"
                        Margin="12,0,-8,0"
                        AutomationProperties.Name="Enabled"
                        IsOn="{x:Bind Enabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                    <Button
                        AutomationProperties.Name="Edit shortcut"
                        Click="OnEditClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Edit">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Delete shortcut"
                        Click="OnDeleteClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Delete">
                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="{StaticResource SettingsCardSpacing}">
            <InfoBar
                Title="Shortcuts are paused"
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                Message="Volume shortcuts won't work until you resume them."
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.ResumeCommand}" Content="Resume" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock
                Margin="1,0,0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Hold a shortcut's keys and press Volume Up or Volume Down on your keyboard (or turn the volume wheel), or press Mute to mute and unmute the app. The volume keys on their own still control the main Windows volume. No volume keys? Edit a shortcut and pick any other keys, like F9, F10 and F11."
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Whichever app you're using" />

            <controls:SettingsCard Description="{x:Bind ViewModel.Focused.Subtitle, Mode=OneWay}" Header="{x:Bind ViewModel.Focused.Title, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE7BA;"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Focused.Error, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Focused.HasError, Mode=OneWay}" />
                    <ItemsControl
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.Focused.KeysDescription, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Focused.KeysDescription, Mode=OneWay}"
                        ItemTemplate="{StaticResource KeyChipTemplate}"
                        ItemsPanel="{StaticResource KeyChipPanel}"
                        ItemsSource="{x:Bind ViewModel.Focused.Keys, Mode=OneWay}" />
                    <ToggleSwitch
                        MinWidth="0"
                        Margin="12,0,-8,0"
                        AutomationProperties.Name="Enabled"
                        IsOn="{x:Bind ViewModel.Focused.Enabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                    <Button
                        AutomationProperties.Name="Edit shortcut"
                        Click="OnEditFocusedClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Edit">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                    </Button>
                </StackPanel>
            </controls:SettingsCard>

            <Grid Margin="0,0,0,0">
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Specific apps" />
                <Button
                    Margin="0,20,0,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Add shortcut"
                    Click="OnAddClick"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add shortcut" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Visibility="{x:Bind ViewModel.HasNoApps, Mode=OneWay}">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Add a shortcut to control one app's volume no matter which window is focused, for example Ctrl + Shift + Volume for your music player."
                    TextWrapping="Wrap" />
            </Border>

            <ItemsRepeater ItemTemplate="{StaticResource AppBindingTemplate}" ItemsSource="{x:Bind ViewModel.Apps}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Volume" />

            <controls:SettingsCard
                Description="How much each press of a volume key changes an app's volume, in percent."
                Header="Volume step">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox
                    MinWidth="120"
                    LargeChange="5"
                    Maximum="{x:Bind General.MaxVolumeStep}"
                    Minimum="{x:Bind General.MinVolumeStep}"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind General.VolumeStep, Mode=TwoWay}" />
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Volume flyout" />

            <controls:SettingsExpander
                Description="The indicator that appears while you change an app's volume."
                Header="Flyout position"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </controls:SettingsExpander.HeaderIcon>
                <Button Command="{x:Bind General.PreviewFlyoutCommand}" Content="Preview" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Monitor">
                        <ComboBox
                            MinWidth="260"
                            ItemsSource="{x:Bind General.MonitorOptions}"
                            SelectedIndex="{x:Bind General.MonitorIndex, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Position on screen">
                        <ComboBox
                            MinWidth="260"
                            ItemsSource="{x:Bind General.PositionOptions}"
                            SelectedIndex="{x:Bind General.PositionIndex, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Startup" />

            <controls:SettingsCard
                Description="Launch KeyboardMixer in the system tray when you sign in."
                Header="Start with Windows">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind General.StartWithWindows, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="Open in the tray instead of showing this window when you start the app yourself."
                Header="Start minimized">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE921;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind General.LaunchMinimized, Mode=TwoWay}" />
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="About" />

            <controls:SettingsExpander Description="{x:Bind Version}" Header="KeyboardMixer">
                <controls:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/icon.ico" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="{x:Bind SettingsPath}" Header="Settings file">
                        <Button Click="OnOpenSettingsFolderClick" Content="Open folder" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Click="OnSourceClick"
                        Header="Source code and releases"
                        IsClickEnabled="True">
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
