<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KeyboardMixer.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KeyboardMixer volume">

    <Grid
        x:Name="Root"
        Padding="16,0,18,0"
        ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid
            Width="32"
            Height="32"
            VerticalAlignment="Center">
            <FontIcon
                x:Name="FallbackIcon"
                FontSize="22"
                Glyph="&#xE767;" />
            <Image
                x:Name="AppIcon"
                Width="32"
                Height="32" />
        </Grid>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                x:Name="AppName"
                MaxLines="1"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <Slider
                x:Name="VolumeSlider"
                IsHitTestVisible="False"
                IsTabStop="False"
                Maximum="100"
                Minimum="0" />
            <TextBlock
                x:Name="NoAudioText"
                Margin="0,4,0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Not playing audio"
                Visibility="Collapsed" />
        </StackPanel>

        <TextBlock
            x:Name="VolumeText"
            Grid.Column="2"
            MinWidth="30"
            Margin="0,22,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            TextAlignment="Right" />
    </Grid>
</Window>
