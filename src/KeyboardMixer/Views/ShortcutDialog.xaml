<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="KeyboardMixer.Views.ShortcutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeyboardMixer.Views"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Width="460" Spacing="20">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Keys" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Pick the keys to hold, then the key to press for each action. Click a key to change it."
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,4,0,0"
                Orientation="Horizontal"
                Spacing="6">
                <ToggleButton
                    x:Name="WinToggle"
                    MinWidth="60"
                    Click="OnModifierToggled"
                    Content="Win" />
                <ToggleButton
                    x:Name="CtrlToggle"
                    MinWidth="60"
                    Click="OnModifierToggled"
                    Content="Ctrl" />
                <ToggleButton
                    x:Name="AltToggle"
                    MinWidth="60"
                    Click="OnModifierToggled"
                    Content="Alt" />
                <ToggleButton
                    x:Name="ShiftToggle"
                    MinWidth="60"
                    Click="OnModifierToggled"
                    Content="Shift" />
            </StackPanel>
            <Grid
                Margin="0,4,0,0"
                ColumnSpacing="12"
                RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Volume up" />
                <Button
                    x:Name="UpKeyButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Volume up key"
                    Click="OnKeyButtonClick"
                    LostFocus="OnKeyButtonLostFocus"
                    Tag="VolumeUp" />
                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Text="Volume down" />
                <Button
                    x:Name="DownKeyButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Volume down key"
                    Click="OnKeyButtonClick"
                    LostFocus="OnKeyButtonLostFocus"
                    Tag="VolumeDown" />
                <TextBlock
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Text="Mute" />
                <Button
                    x:Name="MuteKeyButton"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Mute key"
                    Click="OnKeyButtonClick"
                    LostFocus="OnKeyButtonLostFocus"
                    Tag="ToggleMute" />
                <Button
                    x:Name="ClearMuteButton"
                    Grid.Row="2"
                    Grid.Column="2"
                    AutomationProperties.Name="No mute key"
                    Click="OnClearMuteClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="No mute key">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
            </Grid>
            <HyperlinkButton
                x:Name="ResetKeysButton"
                Padding="0,4"
                Click="OnResetKeysClick"
                Content="Use the keyboard's volume keys" />
        </StackPanel>

        <StackPanel x:Name="AppSection" Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="App" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ExeBox"
                    AutomationProperties.Name="Program name"
                    PlaceholderText="Program name, for example spotify.exe"
                    TextChanged="OnExeTextChanged" />
                <Button
                    Grid.Column="1"
                    Click="OnBrowseClick"
                    Content="Browse…" />
            </Grid>

            <TextBlock
                Margin="0,8,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Or pick an app that's playing audio" />
            <Grid MinHeight="64">
                <ListView
                    x:Name="AppList"
                    MaxHeight="232"
                    AutomationProperties.Name="Apps playing audio"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    SelectionChanged="OnAppSelected"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppChoice">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Source="{x:Bind Icon, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ExeName}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="24"
                    Height="24"
                    IsActive="False" />
                <TextBlock
                    x:Name="NoAppsText"
                    Margin="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No apps are playing audio right now. Type a program name or browse for it instead."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </StackPanel>

        <InfoBar
            x:Name="ErrorBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />
    </StackPanel>
</ContentDialog>
