<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="KeyboardMixer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page layout, matching the PowerToys settings spacing -->
            <x:Double x:Key="PageMaxWidth">1000</x:Double>
            <Thickness x:Key="PagePadding">36,24,36,36</Thickness>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>

            <!-- A single keyboard key, styled like PowerToys' KeyVisual -->
            <DataTemplate x:Key="KeyChipTemplate">
                <Border
                    MinWidth="36"
                    Padding="10,4"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorOnAccentDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{Binding}" />
                </Border>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="KeyChipPanel">
                <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
